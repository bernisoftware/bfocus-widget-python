          }
        }
      ]
    },
    {
      "name": "latest nulo nao grava nem acende",
      "initial": {
        "last_seen": null,
        "label": ""
      },
      "steps": [
        {
          "op": "state",
          "latest_event_at": null,
          "expect": {
            "label": "",
            "last_seen": null
          }
        }
      ]
    },
    {
      "name": "mesmo instante em outro fuso nao acende",
      "initial": {
        "last_seen": "2026-09-01T10:00:00+00:00",
        "label": ""
      },
      "steps": [
        {
          "op": "state",
          "latest_event_at": "2026-09-01T07:00:00-03:00",
          "expect": {
            "label": "",
            "last_seen": "2026-09-01T10:00:00+00:00"
          }
        }
      ]
    },
    {
      "name": "aberto: badge segue o unread e o seen move a base",
      "initial": {
        "last_seen": "2026-09-01T10:00:00+00:00",
        "label": "•"
      },
      "steps": [
        {
          "op": "open",
          "expect": {
            "label": "•"
          }
        },
        {
          "op": "state",
          "latest_event_at": "2026-09-01T10:05:00+00:00",
          "expect": {
            "label": "•",
            "last_seen": "2026-09-01T10:00:00+00:00"
          }
        },
        {
          "op": "unread",
          "count": 3,
          "expect": {
            "label": "3"
          }
        },
        {
          "op": "unread",
          "count": 120,
          "expect": {
            "label": "99+"
          }
        },
        {
          "op": "seen",
          "latest_event_at": "2026-09-01T10:05:00+00:00",
          "expect": {
            "last_seen": "2026-09-01T10:05:00+00:00"
          }
        },
        {
          "op": "unread",
          "count": 0,
          "expect": {
            "label": ""
          }
        },
        {
          "op": "close",
          "expect": {
            "label": ""
          }
        },
        {
          "op": "state",
          "latest_event_at": "2026-09-01T10:05:00+00:00",
          "expect": {
            "label": "",
            "last_seen": "2026-09-01T10:05:00+00:00"
          }
        }
      ]
    }
