  "push": {
    "register": {
      "config": "min",
      "token": "fcm-token-1",
      "platform": "android",
      "expect": {
        "method": "POST",
        "url": "https://api.bfocus.com.br/api/v1/widget/push/devices",
        "json": {
          "token": "fcm-token-1",
          "platform": "android",
          "app_id": "com.empresa.erp"
        }
      }
    },
    "unregister": {
      "config": "min",
      "token": "fcm-token-1",
      "expect": {
        "method": "POST",
        "url": "https://api.bfocus.com.br/api/v1/widget/push/devices/unregister",
        "json": {
          "token": "fcm-token-1"
        }
      }
    },
    "handle": [
      {
        "name": "resposta no chamado",
        "data": {
          "bfocus": "1",
          "type": "ticket.reply",
          "ticket_id": "t-1"
        },
        "expect": {
          "handled": true,
          "navigate": {
            "view": "ticket",
            "ticketId": "t-1"
          }
        }
      },
      {
        "name": "mensagem de chat",
        "data": {
          "bfocus": "1",
          "type": "chat.message",
          "ticket_id": "t-2",
          "conversation_id": "c-1"
        },
        "expect": {
          "handled": true,
          "navigate": {
            "view": "chat",
            "conversationId": "c-1"
          }
        }
      },
      {
        "name": "mudanca de status",
        "data": {
          "bfocus": "1",
          "type": "ticket.status",
          "ticket_id": "t-3"
        },
        "expect": {
          "handled": true,
          "navigate": {
            "view": "ticket",
            "ticketId": "t-3"
          }
        }
      },
      {
        "name": "tipo desconhecido abre a lista",
        "data": {
          "bfocus": "1",
          "type": "algo.novo"
        },
        "expect": {
          "handled": true,
          "navigate": {
            "view": "list"
          }
        }
      },
      {
        "name": "push de outro sistema",
        "data": {
          "foo": "bar"
        },
        "expect": {
          "handled": false,
          "navigate": null
        }
      }
    ]
  },
